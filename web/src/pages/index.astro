---
import '../ui/style.css';
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>aimcurve</title>
  <link rel="stylesheet" href="/vendor/uPlot.min.css" />
</head>
<body class="picking">
  <section id="pick" class="pick">
    <h1>aimcurve</h1>
    <p class="lede">Your KovaaK's run history, read in this tab.</p>
    <p class="promise">
      <strong>Nothing is uploaded.</strong> Your browser will ask to
      &ldquo;upload&rdquo; the folder &mdash; that is its wording for granting
      read access, and it is wrong here. The files are read in this tab, the
      index is stored on this machine, and no request leaves it.
    </p>
    <p class="promise">aimcurve never writes to your KovaaK's install.</p>

    <!-- Exactly one of these is shown. Two identically-labelled controls side
         by side is a coin toss, and the picker's error handler says "try the
         folder button below instead" -- which has to refer to something the
         user can tell apart. boot.ts reveals #pickDir and hides #pickUploadLabel
         when showDirectoryPicker exists, and leaves this default otherwise. -->
    <div class="pick-actions">
      <button id="pickDir" hidden>Choose your KovaaK's folder</button>
      <label class="button" id="pickUploadLabel" for="pickUpload">Choose folder (upload)</label>
      <input id="pickUpload" type="file" webkitdirectory multiple hidden />
    </div>
    <p class="hint">
      The folder that contains <code>stats</code> and <code>performances</code>.
      On a default install that is <code>…\steamapps\common\FPSAimTrainer\FPSAimTrainer</code>.
    </p>

    <p id="pickProgress" class="progress" hidden></p>
    <p id="pickError" class="error" hidden></p>
  </section>

  <!-- Carried over from aimcurve/web/index.html, and staying direct children
       of <body> so the body grid still sizes them. `body.picking` hides them;
       boot.ts drops that class when there is something to show. -->
  <header class="topbar">
    <div class="brand">kv<span>stats</span></div>

    <nav class="views" role="tablist" aria-label="views">
      <button class="vtab" role="tab" data-view="run" aria-selected="true">Run</button>
      <button class="vtab" role="tab" data-view="session" aria-selected="false">Session</button>
      <button class="vtab" role="tab" data-view="scenarios" aria-selected="false">Scenarios</button>
    </nav>

    <div class="top-right">
      <div class="health" id="health" hidden></div>
      <button id="repick" class="repick" data-stale="0" title="Read the folder again">
        <span id="repickAge">—</span>
        <span class="repick-do">refresh</span>
      </button>
      <div class="status" id="status" data-state="stale">
        <span class="dot" aria-hidden="true"></span>
        <span class="status-label">—</span>
      </div>
    </div>
  </header>

  <!-- ───────────────────────────── RUN VIEW ───────────────────────────── -->
  <main class="view run-view" id="view-run">
    <section class="stage">

      <div class="headline" id="headline" data-state="ok">
        <div class="hl-id">
          <h1 class="scenario" id="hlScenario">—</h1>
          <div class="meta">
            <span id="hlTime">—</span><i class="sep"></i>
            <span id="hlDur">—</span><i class="sep"></i>
            <span id="hlCfg">—</span>
          </div>
        </div>

        <div class="hl-delta" id="hlDelta" data-sign="none">
          <div class="delta-figure">
            <span class="arrow" id="hlArrow" aria-hidden="true">·</span>
            <span class="num" id="hlDeltaPct">—</span>
          </div>
          <div class="delta-sub" id="hlDeltaSub">no baseline yet</div>
        </div>

        <div class="hl-score">
          <div class="k">score</div>
          <div class="v num" id="hlScore">—</div>
        </div>

        <dl class="hl-stats" id="hlStats"></dl>
      </div>

      <section class="panel" id="panel-rate">
        <div class="panel-head">
          <h2 class="panel-title">Rate per second <span class="unit" id="rateUnit">score / s</span></h2>
          <div class="panel-note" id="rateNote" hidden></div>
          <div class="legend" id="rateLegend">
            <span class="chip" data-k="run"><i class="sw sw-run"></i>this run<b class="num" id="lgRun">—</b></span>
            <span class="chip" data-k="pb"><i class="sw sw-pb"></i><span id="lgPbLabel">PB</span><b class="num" id="lgPb">—</b></span>
            <span class="chip" data-k="band"><i class="sw sw-band"></i>recent <span id="lgRecentN">10</span> mean ±1σ<b class="num" id="lgBand">—</b></span>
            <span class="chip chip-t"><i class="sw sw-t"></i><b class="num" id="lgT">—</b></span>
          </div>
        </div>
        <div class="chart" id="chartRate"></div>
        <div class="chart-empty" id="rateEmpty" hidden></div>
      </section>

      <section class="panel" id="panel-delta">
        <div class="panel-head">
          <h2 class="panel-title">Cumulative Δ vs baseline <span class="unit" id="deltaUnit">score</span></h2>
          <div class="legend">
            <span class="chip"><i class="sw sw-up"></i>ahead</span>
            <span class="chip"><i class="sw sw-down"></i>behind</span>
            <span class="chip chip-t"><b class="num" id="lgDelta">—</b></span>
          </div>
        </div>
        <div class="chart chart-sm" id="chartDelta"></div>
        <div class="chart-empty" id="deltaEmpty" hidden></div>
      </section>

      <section class="panel" id="splitPanel" hidden>
        <div class="panel-head"><h2 class="panel-title"><span id="splitTitle">Splits</span> <span class="unit" id="splitSub"></span></h2></div>
        <div class="table-wrap"><table id="splitTable"></table></div>
      </section>

      <div class="controls" id="controls">
        <div class="ctl" id="ctlMetricGroup">
          <span class="ctl-k">metric</span>
          <div class="seg" id="ctlMetric" role="radiogroup" aria-label="metric"></div>
        </div>
        <div class="ctl">
          <span class="ctl-k">smoothing</span>
          <div class="seg" id="ctlSmooth" role="radiogroup" aria-label="smoothing"></div>
        </div>
        <div class="ctl">
          <span class="ctl-k">recent</span>
          <div class="stepper">
            <button type="button" data-step="-1" aria-label="fewer recent runs">−</button>
            <input class="num" id="ctlRecent" type="number" min="1" max="50" step="1" value="10" aria-label="recent runs" />
            <button type="button" data-step="1" aria-label="more recent runs">+</button>
          </div>
        </div>
        <label class="ctl toggle">
          <input type="checkbox" id="ctlSameCfg" checked />
          <span class="tgl" aria-hidden="true"></span>
          <span class="ctl-k">same sensitivity only</span>
        </label>
      </div>
    </section>

    <aside class="rail">
      <div class="rail-head">
        <span>Runs</span>
        <button class="rail-filter" id="railFilter" type="button" hidden></button>
      </div>
      <ol class="runlist" id="runlist" tabindex="0" role="listbox" aria-label="run history"></ol>
      <div class="rail-foot" id="railFoot"></div>
    </aside>
  </main>

  <!-- ─────────────────────────── SESSION VIEW ─────────────────────────── -->
  <section class="view sheet" id="view-session" hidden>
    <div class="sheet-head">
      <h2>Session</h2>
      <div class="sheet-sub" id="sessionDay">—</div>
    </div>
    <dl class="sum" id="sessionSum"></dl>
    <div class="table-wrap"><table class="tbl" id="sessionTable"></table></div>
  </section>

  <!-- ────────────────────────── SCENARIOS VIEW ────────────────────────── -->
  <section class="view sheet" id="view-scenarios" hidden>
    <div class="sheet-head">
      <h2>Scenarios</h2>
      <div class="sheet-sub" id="scenSub">—</div>
    </div>
    <div class="table-wrap"><table class="tbl" id="scenTable"></table></div>
  </section>

  <script src="/vendor/uPlot.iife.min.js" is:inline></script>
  <script>
    import '../boot.ts';
  </script>
</body>
</html>
