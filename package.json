{
  "name": "aimcurve",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --reporter=verbose",
    "gen:proto": "buf generate"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@electric-sql/pglite": "^0.5.8",
    "@vueuse/core": "^15.0.0",
    "drizzle-orm": "^0.45.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.15.0",
    "@types/node": "^26.6.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}