# Curated KovaaK's fixtures are tracked with Git LFS. They are opaque test
# inputs — never hand-edited, only re-copied from a real install — so losing
# readable diffs on them costs nothing, and keeping them out of the pack file
# means the repo does not grow every time the set is extended.
#
# `raw/` is gitignored and never reaches LFS.
test/fixtures/curated/**/*.perf filter=lfs diff=lfs merge=lfs -text
test/fixtures/curated/**/*.csv  filter=lfs diff=lfs merge=lfs -text
# The About page's sample runs, same treatment (see test/fixtures/demo/README.md).
test/fixtures/demo/**/*.perf filter=lfs diff=lfs merge=lfs -text
test/fixtures/demo/**/*.csv  filter=lfs diff=lfs merge=lfs -text

# Generated from the demo fixtures by `pnpm gen:demo`; the snapshot test fails
# when it drifts. Not LFS, so the Pages deploy needs no LFS checkout.
src/data/demo-snapshot.json linguist-generated -diff

# Sourced by bash through direnv; a CR would break it.
.envrc eol=lf
